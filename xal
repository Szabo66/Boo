function loadPanel(title, content) {
  const workspace = document.querySelector('.workspace');
  workspace.innerHTML = `
    <div class="tool-panel">
      <h3>${title}</h3>
      ${content}
    </div>
  `;
}

document.querySelector('.tool:nth-child(1)').addEventListener('click', () => {
  loadPanel("Style Transform", `
    <p>Select a style:</p>
    <button class="subtool">Cartoon</button>
    <button class="subtool">Game</button>
    <button class="subtool">Movie</button>
    <button class="subtool">TV</button>
  `);
});

